{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"$CLAUDE_PROJECT_DIR/.claude/hooks/start_doctor.py\" || echo \"Claude Code's start-up hook couldn't run doctor. If uv is missing, install uv (https://docs.astral.sh/uv/getting-started/installation/), then run: uv run --script scripts/doctor.py\"",
            "timeout": 90,
            "statusMessage": "Checking the clone with doctor"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*pytest*)",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pytest_scope.py\" || exit 1"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/review_workflow.py\" || exit 1"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/review_workflow.py\" || exit 1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.css)",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_stylesheet.py\"; case $? in 0) exit 0;; 3) exit 2;; *) exit 1;; esac",
            "asyncRewake": true,
            "statusMessage": "Checking the stylesheet"
          },
          {
            "type": "command",
            "if": "Write(*.css)",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_stylesheet.py\"; case $? in 0) exit 0;; 3) exit 2;; *) exit 1;; esac",
            "asyncRewake": true,
            "statusMessage": "Checking the stylesheet"
          },
          {
            "type": "command",
            "if": "Edit(*.py)",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_python.py\" || exit 1",
            "statusMessage": "Running ruff"
          },
          {
            "type": "command",
            "if": "Write(*.py)",
            "command": "uv run --no-sync python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_python.py\" || exit 1",
            "statusMessage": "Running ruff"
          }
        ]
      }
    ]
  }
}
